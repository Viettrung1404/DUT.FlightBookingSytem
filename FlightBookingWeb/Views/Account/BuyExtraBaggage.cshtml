@model FlightBookingWeb.ViewModels.BuyBaggageViewModel

<style>
    :root {
        --primary-color: #2563eb;
        --secondary-color: #64748b;
        --success-color: #10b981;
        --warning-color: #f59e0b;
        --info-color: #3b82f6;
        --danger-color: #ef4444;
        --light-bg: #f8fafc;
        --dark-text: #1e293b;
        --border-radius: 16px;
        --shadow-sm: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
        --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
        --shadow-xl: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
    }

    body {
        /* background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); */
        min-height: 100vh;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        /* padding: 2rem 1rem; */
    }

    .baggage-container {
        max-width: 800px;
        margin: 40px auto 60px;
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(20px);
        border-radius: var(--border-radius);
        box-shadow: var(--shadow-xl);
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .page-header {
        background: linear-gradient(135deg, #3b82f6, #1d4ed8);
        color: white;
        padding: 2rem;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

        .page-header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: repeating-linear-gradient( 45deg, transparent, transparent 20px, rgba(255,255,255,0.05) 20px, rgba(255,255,255,0.05) 40px );
        }

        .page-header h3 {
            margin: 0;
            font-size: 1.75rem;
            font-weight: 700;
            position: relative;
            z-index: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.75rem;
        }

        .page-header .baggage-icon {
            font-size: 2rem;
            opacity: 0.9;
        }

    .flight-info-section {
        padding: 2rem;
        background: linear-gradient(135deg, #f8fafc, #e2e8f0);
        border-bottom: 1px solid #e2e8f0;
    }

    .flight-info-card {
        background: white;
        border-radius: 12px;
        padding: 1.5rem;
        box-shadow: var(--shadow-sm);
        border: 1px solid #e2e8f0;
    }

    .flight-info-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--dark-text);
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .flight-details {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
    }

    .detail-item {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.75rem;
        background: #f8fafc;
        border-radius: 8px;
        border-left: 4px solid var(--primary-color);
    }

    .detail-icon {
        color: var(--primary-color);
        font-size: 1.1rem;
        width: 20px;
        text-align: center;
    }

    .detail-content {
        flex: 1;
    }

    .detail-label {
        font-weight: 600;
        color: var(--dark-text);
        font-size: 0.875rem;
        margin-bottom: 0.25rem;
    }

    .detail-value {
        color: var(--secondary-color);
        font-size: 0.95rem;
    }

    .baggage-form-section {
        padding: 2rem;
    }

    .form-section-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--dark-text);
        margin-bottom: 1.5rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .baggage-form {
        background: white;
        border-radius: 12px;
        padding: 1.5rem;
        box-shadow: var(--shadow-sm);
        border: 1px solid #e2e8f0;
    }

    .form-group {
        margin-bottom: 1.5rem;
    }

    .form-label {
        display: block;
        font-weight: 600;
        color: var(--dark-text);
        margin-bottom: 0.75rem;
        font-size: 0.95rem;
    }

    .form-select {
        width: 100%;
        padding: 0.875rem 1rem;
        border: 2px solid #e2e8f0;
        border-radius: 10px;
        font-size: 1rem;
        background: white;
        transition: all 0.2s ease;
        appearance: none;
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' fill='none' viewBox='0 0 20 20'%3e%3cpath stroke='%236b7280' stroke-linecap='round' stroke-linejoin='round' stroke-width='1.5' d='m6 8 4 4 4-4'/%3e%3c/svg%3e");
        background-position: right 0.75rem center;
        background-repeat: no-repeat;
        background-size: 1.5em 1.5em;
        padding-right: 3rem;
    }

        .form-select:focus {
            outline: none;
            border-color: var(--primary-color);
            box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
        }

    .baggage-option {
        padding: 0.5rem 0;
    }

    .payment-section {
        padding: 0 2rem 2rem;
    }

    .payment-container {
        background: white;
        border-radius: 12px;
        padding: 1.5rem;
        box-shadow: var(--shadow-sm);
        border: 1px solid #e2e8f0;
        text-align: center;
    }

    .payment-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--dark-text);
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
    }

    .payment-note {
        background: linear-gradient(135deg, #fef3c7, #fde68a);
        color: #92400e;
        padding: 1rem;
        border-radius: 8px;
        margin-bottom: 1.5rem;
        font-size: 0.9rem;
        font-weight: 500;
        border: 1px solid #fbbf24;
    }

    .paypal-container {
        max-width: 400px;
        margin: 0 auto;
    }

    /* Pricing highlights */
    .pricing-highlight {
        background: linear-gradient(135deg, #10b981, #059669);
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.875rem;
        display: inline-block;
        margin-left: 0.5rem;
    }

    /* Loading state */
    .loading-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.5);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 9999;
    }

    .loading-spinner {
        background: white;
        padding: 2rem;
        border-radius: 12px;
        text-align: center;
        box-shadow: var(--shadow-xl);
    }

    .spinner {
        width: 40px;
        height: 40px;
        border: 4px solid #e2e8f0;
        border-top: 4px solid var(--primary-color);
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin: 0 auto 1rem;
    }

    @@keyframes spin {
        0%

    {
        transform: rotate(0deg);
    }

    100% {
        transform: rotate(360deg);
    }

    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        body

    {
        padding: 1rem;
    }

    .page-header {
        padding: 1.5rem;
    }

        .page-header h3 {
            font-size: 1.5rem;
        }

    .flight-info-section,
    .baggage-form-section,
    .payment-section {
        padding: 1.5rem;
    }

    .flight-details {
        grid-template-columns: 1fr;
    }

    .detail-item {
        padding: 1rem;
    }

    }

    /* Custom alert styles */
    .custom-alert {
        position: fixed;
        top: 20px;
        right: 20px;
        background: white;
        border-radius: 12px;
        padding: 1rem 1.5rem;
        box-shadow: var(--shadow-lg);
        border-left: 4px solid;
        z-index: 10000;
        max-width: 400px;
        transform: translateX(100%);
        transition: transform 0.3s ease;
    }

        .custom-alert.show {
            transform: translateX(0);
        }

        .custom-alert.error {
            border-left-color: var(--danger-color);
            background: linear-gradient(135deg, #fef2f2, #fee2e2);
        }

        .custom-alert.success {
            border-left-color: var(--success-color);
            background: linear-gradient(135deg, #f0fdf4, #dcfce7);
        }
</style>

<div class="baggage-container">
    <!-- Header -->
    <div class="page-header">
        <h3>
            <i class="bi bi-bag-plus baggage-icon"></i>
            Mua thêm hành lý cho vé #@Model.TicketId
        </h3>
    </div>

    <!-- Flight Information -->
    <div class="flight-info-section">
        <div class="flight-info-card">
            <div class="flight-info-title">
                <i class="bi bi-airplane"></i>
                Thông tin chuyến bay
            </div>
            <div class="flight-details">
                <div class="detail-item">
                    <i class="bi bi-hash detail-icon"></i>
                    <div class="detail-content">
                        <div class="detail-label">Chuyến bay</div>
                        <div class="detail-value">#@Model.FlightId</div>
                    </div>
                </div>
                <div class="detail-item">
                    <i class="bi bi-geo-alt detail-icon"></i>
                    <div class="detail-content">
                        <div class="detail-label">Khởi hành</div>
                        <div class="detail-value">@Model.DepartureAirport</div>
                    </div>
                </div>
                <div class="detail-item">
                    <i class="bi bi-geo-alt-fill detail-icon"></i>
                    <div class="detail-content">
                        <div class="detail-label">Đến</div>
                        <div class="detail-value">@Model.ArrivalAirport</div>
                    </div>
                </div>
                <div class="detail-item">
                    <i class="bi bi-calendar3 detail-icon"></i>
                    <div class="detail-content">
                        <div class="detail-label">Ngày giờ</div>
                        <div class="detail-value">@Model.DepartureDateTime.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                </div>
                <div class="detail-item">
                    <i class="bi bi-person-seat detail-icon"></i>
                    <div class="detail-content">
                        <div class="detail-label">Ghế</div>
                        <div class="detail-value">@Model.SeatNumber</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Baggage Form -->
    <div class="baggage-form-section">
        <div class="form-section-title">
            <i class="bi bi-bag-check"></i>
            Chọn hành lý bổ sung
        </div>
        <div class="baggage-form">
            <form id="baggage-form">
                <input type="hidden" asp-for="TicketId" />
                <div class="form-group">
                    <label class="form-label">Chọn số kg muốn mua thêm:</label>
                    <select asp-for="ExtraBaggageKg" class="form-select" id="baggage-kg">
                        <option value="0">-- Chọn gói hành lý --</option>
                        @if (ViewBag.BaggageOptions != null)
                        {
                            foreach (var opt in (List<int>)ViewBag.BaggageOptions)
                            {
                                if (opt == 5)
                                {
                                    <option value="5">+5kg <span class="pricing-highlight">(+$20)</span></option>
                                }
                                else if (opt == 10)
                                {
                                    <option value="10">+10kg <span class="pricing-highlight">(+$35)</span></option>
                                }
                            }
                        }
                    </select>
                </div>
            </form>
        </div>
    </div>

    <!-- Payment Section -->
    <div class="payment-section">
        <div class="payment-container">
            <div class="payment-title">
                <i class="bi bi-credit-card"></i>
                Thanh toán
            </div>
            <div class="payment-note">
                <i class="bi bi-info-circle"></i>
                Vui lòng chọn gói hành lý trước khi thanh toán
            </div>
            <div class="paypal-container">
                <div id="paypal-baggage-button-container" class="mt-3"></div>
            </div>
        </div>
    </div>
</div>

<!-- Loading Overlay -->
<div class="loading-overlay" id="loading-overlay">
    <div class="loading-spinner">
        <div class="spinner"></div>
        <p>Đang xử lý thanh toán...</p>
    </div>
</div>

<script src="https://www.paypal.com/sdk/js?client-id=Af-WtkZ5kCVKHEhpFkoFhky-76AatSg3PghCyxCaFlJR9Ix9j2ZAHf1iWBhPTCbkKIYa7ShuT6Rkc8OM&currency=USD"></script>
<script>
    let selectedKg = 0;

    // Custom alert function
    function showAlert(message, type = 'error') {
        const alert = document.createElement('div');
        alert.className = `custom-alert ${type}`;
        alert.innerHTML = `
            <div style="display: flex; align-items: center; gap: 0.5rem;">
                <i class="bi bi-${type === 'error' ? 'exclamation-triangle' : 'check-circle'}"></i>
                <span>${message}</span>
            </div>
        `;
        document.body.appendChild(alert);

        setTimeout(() => alert.classList.add('show'), 100);
        setTimeout(() => {
            alert.classList.remove('show');
            setTimeout(() => document.body.removeChild(alert), 300);
        }, 3000);
    }

    // Show/hide loading overlay
    function showLoading() {
        document.getElementById('loading-overlay').style.display = 'flex';
    }

    function hideLoading() {
        document.getElementById('loading-overlay').style.display = 'none';
    }

    paypal.Buttons({
        createOrder: function () {
            selectedKg = parseInt(document.getElementById('baggage-kg').value);
            if (selectedKg !== 5 && selectedKg !== 10) {
                showAlert("Vui lòng chọn số kg muốn mua thêm (5kg hoặc 10kg).", 'error');
                throw new Error("Invalid baggage selection");
            }

            showLoading();

            return fetch('@Url.Action("CreateBaggagePayPalOrder", "Account")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    TicketId: @Model.TicketId,
                    ExtraBaggageKg: selectedKg
                })
            })
            .then(res => res.json())
            .then(data => {
                hideLoading();
                return data.id;
            })
            .catch(error => {
                hideLoading();
                showAlert("Có lỗi xảy ra khi tạo đơn hàng. Vui lòng thử lại.", 'error');
                throw error;
            });
        },
        onApprove: function (data, actions) {
            showLoading();
            return fetch('@Url.Action("CaptureBaggagePayPalOrder", "Account")?orderId=' + data.orderID, { method: 'POST' })
                .then(res => res.json())
                .then(res => {
                    hideLoading();
                    showAlert(res.message, 'success');
                    setTimeout(() => {
                        window.location.href = '@Url.Action("BookingHistory", "Account")';
                    }, 2000);
                })
                .catch(error => {
                    hideLoading();
                    showAlert("Có lỗi xảy ra khi xử lý thanh toán. Vui lòng thử lại.", 'error');
                });
        },
        onError: function(err) {
            hideLoading();
            showAlert("Có lỗi xảy ra với PayPal. Vui lòng thử lại.", 'error');
        },
        onCancel: function(data) {
            hideLoading();
            showAlert("Bạn đã hủy thanh toán.", 'error');
        }
    }).render('#paypal-baggage-button-container');

    // Update payment note based on selection
    document.getElementById('baggage-kg').addEventListener('change', function() {
        const paymentNote = document.querySelector('.payment-note');
        const selectedValue = this.value;

        if (selectedValue === '0') {
            paymentNote.innerHTML = '<i class="bi bi-info-circle"></i> Vui lòng chọn gói hành lý trước khi thanh toán';
            paymentNote.style.background = 'linear-gradient(135deg, #fef3c7, #fde68a)';
            paymentNote.style.color = '#92400e';
        } else {
            const price = selectedValue === '5' ? '$20' : '$35';
            paymentNote.innerHTML = `<i class="bi bi-check-circle"></i> Bạn đã chọn +${selectedValue}kg (${price}). Nhấn nút PayPal để thanh toán.`;
            paymentNote.style.background = 'linear-gradient(135deg, #dcfce7, #bbf7d0)';
            paymentNote.style.color = '#166534';
        }
    });
</script>