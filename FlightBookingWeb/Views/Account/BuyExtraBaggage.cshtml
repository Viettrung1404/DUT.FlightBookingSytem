@model FlightBookingWeb.ViewModels.BuyBaggageViewModel

<h3>Mua thêm hành lý cho vé #@Model.TicketId</h3>
<div class="mb-3">
    <strong>Chuyến bay:</strong> #@Model.FlightId<br />
    <strong>Khởi hành:</strong> @Model.DepartureAirport<br />
    <strong>Đến:</strong> @Model.ArrivalAirport<br />
    <strong>Ngày giờ:</strong> @Model.DepartureDateTime.ToString("dd/MM/yyyy HH:mm")<br />
    <strong>Ghế:</strong> @Model.SeatNumber
</div>

<form id="baggage-form">
    <input type="hidden" asp-for="TicketId" />
    <div class="mb-3">
        <label>Chọn số kg muốn mua thêm:</label>
        <select asp-for="ExtraBaggageKg" class="form-select" id="baggage-kg">
            <option value="0">-- Chọn --</option>
            @if (ViewBag.BaggageOptions != null)
            {
                foreach (var opt in (List<int>)ViewBag.BaggageOptions)
                {
                    if (opt == 5)
                    {
                        <option value="5">+5kg (+$20)</option>
                    }
                    else if (opt == 10)
                    {
                        <option value="10">+10kg (+$35)</option>
                    }
                }
            }
        </select>
    </div>
</form>

<div id="paypal-baggage-button-container" class="mt-3"></div>

<script src="https://www.paypal.com/sdk/js?client-id=Af-WtkZ5kCVKHEhpFkoFhky-76AatSg3PghCyxCaFlJR9Ix9j2ZAHf1iWBhPTCbkKIYa7ShuT6Rkc8OM&currency=USD"></script>
<script>
    let selectedKg = 0;

    paypal.Buttons({
        createOrder: function () {
            selectedKg = parseInt(document.getElementById('baggage-kg').value);
            if (selectedKg !== 5 && selectedKg !== 10) {
                alert("Vui lòng chọn số kg muốn mua thêm (5kg hoặc 10kg).");
                throw new Error("Invalid baggage selection");
            }
            return fetch('@Url.Action("CreateBaggagePayPalOrder", "Account")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    TicketId: @Model.TicketId,
                    ExtraBaggageKg: selectedKg
                })
            })
            .then(res => res.json())
            .then(data => data.id);
        },
        onApprove: function (data, actions) {
            return fetch('@Url.Action("CaptureBaggagePayPalOrder", "Account")?orderId=' + data.orderID, { method: 'POST' })
                .then(res => res.json())
                .then(res => {
                    alert(res.message);
                    window.location.href = '@Url.Action("BookingHistory", "Account")';
                });
        }
    }).render('#paypal-baggage-button-container');
</script>
