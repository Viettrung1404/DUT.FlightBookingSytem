@{
    ViewData["Title"] = "Lịch sử đặt vé";
    var pastTickets = ViewBag.PastTickets as List<FlightBookingWeb.Models.Ticket>;
    var futureTickets = ViewBag.FutureTickets as List<FlightBookingWeb.Models.Ticket>;
}

<style>
    :root {
        --primary-color: #2563eb;
        --secondary-color: #64748b;
        --success-color: #10b981;
        --warning-color: #f59e0b;
        --info-color: #3b82f6;
        --danger-color: #ef4444;
        --light-bg: #f8fafc;
        --dark-text: #1e293b;
        --border-radius: 16px;
        --shadow-sm: 0 1px 3px 0 rgb(0 0 0 / 0.1), 0 1px 2px -1px rgb(0 0 0 / 0.1);
        --shadow-md: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
        --shadow-lg: 0 10px 15px -3px rgb(0 0 0 / 0.1), 0 4px 6px -4px rgb(0 0 0 / 0.1);
    }

    body {
        min-height: 100vh;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 2rem 1rem;
    }

    .page-title {
        text-align: center;
        margin-bottom: 3rem;
        color: white;
        text-shadow: 0 2px 4px rgba(0,0,0,0.3);
    }

        .page-title h2 {
            font-size: 2.5rem;
            font-weight: 700;
            margin: 0;
            background: linear-gradient(48deg, #fff, #686868);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .page-title .subtitle {
            font-size: 1.1rem;
            opacity: 0.9;
            margin-top: 0.5rem;
            color: black;
        }

    .alert {
        border-radius: var(--border-radius);
        border: none;
        box-shadow: var(--shadow-md);
        margin-bottom: 2rem;
        background: linear-gradient(135deg, #fca5a5, #f87171);
        color: white;
        font-weight: 500;
    }

    .section-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(20px);
        border-radius: var(--border-radius);
        box-shadow: var(--shadow-lg);
        margin-bottom: 2rem;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .section-header {
        padding: 1.5rem 2rem;
        position: relative;
        overflow: hidden;
    }

        .section-header::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            opacity: 0.1;
            background: repeating-linear-gradient( 45deg, transparent, transparent 10px, rgba(255,255,255,0.1) 10px, rgba(255,255,255,0.1) 20px );
        }

    .future-tickets .section-header {
        background: linear-gradient(135deg, #10b981, #059669);
        color: white;
    }

    .past-tickets .section-header {
        background: linear-gradient(135deg, #64748b, #475569);
        color: white;
    }

    .section-header h5 {
        margin: 0;
        font-size: 1.25rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 0.75rem;
        position: relative;
        z-index: 1;
    }

    .section-header i {
        font-size: 1.5rem;
    }

    .section-body {
        padding: 0;
    }

    .custom-table {
        margin: 0;
        background: white;
    }

        .custom-table thead th {
            background: var(--light-bg);
            border: none;
            font-weight: 600;
            color: var(--dark-text);
            padding: 1rem 1.5rem;
            font-size: 0.875rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .custom-table tbody td {
            padding: 1.25rem 1.5rem;
            border-top: 1px solid #e2e8f0;
            vertical-align: middle;
        }

        .custom-table tbody tr {
            transition: all 0.2s ease;
        }

            .custom-table tbody tr:hover {
                background: linear-gradient(90deg, rgba(59, 130, 246, 0.05), rgba(59, 130, 246, 0.02));
                transform: translateX(4px);
            }

    .ticket-id {
        font-family: 'Courier New', monospace;
        font-weight: 600;
        color: var(--primary-color);
        background: rgba(37, 99, 235, 0.1);
        padding: 0.25rem 0.5rem;
        border-radius: 6px;
        font-size: 0.875rem;
    }

    .flight-badge {
        background: linear-gradient(135deg, #3b82f6, #1d4ed8);
        color: white;
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        box-shadow: var(--shadow-sm);
    }

    .datetime-info {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 500;
        color: var(--dark-text);
    }

    .seat-info {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 700;
        color: var(--primary-color);
        font-size: 1.1rem;
    }

    .seat-class-badge {
        background: linear-gradient(135deg, #64748b, #475569);
        color: white;
        padding: 0.375rem 0.75rem;
        border-radius: 12px;
        font-weight: 600;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .baggage-container {
        display: flex;
        flex-wrap: wrap;
        gap: 0.375rem;
    }

    .baggage-badge {
        background: linear-gradient(135deg, #10b981, #059669);
        color: white;
        padding: 0.375rem 0.75rem;
        border-radius: 12px;
        font-weight: 600;
        font-size: 0.75rem;
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        box-shadow: var(--shadow-sm);
    }

    .no-baggage-badge {
        background: #f1f5f9;
        color: #64748b;
        padding: 0.375rem 0.75rem;
        border-radius: 12px;
        font-weight: 500;
        font-size: 0.75rem;
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
    }

    .action-buttons {
        display: flex;
        gap: 0.5rem;
        justify-content: center;
    }

    .action-btn {
        padding: 0.5rem 1rem;
        border-radius: 10px;
        font-weight: 600;
        font-size: 0.875rem;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        transition: all 0.2s ease;
        border: none;
        box-shadow: var(--shadow-sm);
    }

        .action-btn:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
            text-decoration: none;
        }

    .btn-upgrade {
        background: linear-gradient(135deg, #f59e0b, #d97706);
        color: white;
    }

        .btn-upgrade:hover {
            background: linear-gradient(135deg, #d97706, #b45309);
            color: white;
        }

    .btn-baggage {
        background: linear-gradient(135deg, #3b82f6, #1d4ed8);
        color: white;
    }

        .btn-baggage:hover {
            background: linear-gradient(135deg, #1d4ed8, #1e40af);
            color: white;
        }

    .empty-state {
        padding: 3rem 2rem;
        text-align: center;
        color: #64748b;
        background: linear-gradient(135deg, #f8fafc, #f1f5f9);
    }

        .empty-state i {
            font-size: 3rem;
            margin-bottom: 1rem;
            opacity: 0.5;
        }

        .empty-state p {
            font-size: 1.1rem;
            margin: 0;
            font-weight: 500;
        }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .container

    {
        padding: 1rem;
    }

    .page-title h2 {
        font-size: 2rem;
    }

    .section-header {
        padding: 1rem 1.5rem;
    }

    .custom-table thead th,
    .custom-table tbody td {
        padding: 0.75rem 1rem;
    }

    .action-buttons {
        flex-direction: column;
        gap: 0.25rem;
    }

    .action-btn {
        font-size: 0.8rem;
        padding: 0.375rem 0.75rem;
    }

    }

    /* Custom scrollbar for table */
    .table-responsive::-webkit-scrollbar {
        height: 8px;
    }

    .table-responsive::-webkit-scrollbar-track {
        background: #f1f5f9;
        border-radius: 4px;
    }

    .table-responsive::-webkit-scrollbar-thumb {
        background: linear-gradient(90deg, #3b82f6, #1d4ed8);
        border-radius: 4px;
    }

        .table-responsive::-webkit-scrollbar-thumb:hover {
            background: linear-gradient(90deg, #1d4ed8, #1e40af);
        }
</style>

@if (TempData["BaggageError"] != null)
{
    <div class="alert alert-danger text-center">
        @TempData["BaggageError"]
    </div>
}

<div class="container">
    <div class="page-title">
        <h2>
            <i class="bi bi-clock-history"></i> Lịch sử đặt vé
        </h2>
        <p class="subtitle">Quản lý và theo dõi các chuyến bay của bạn</p>
    </div>

    <!-- Vé sắp tới -->
    <div class="section-card future-tickets">
        <div class="section-header">
            <h5>
                <i class="bi bi-calendar-event"></i> Vé sắp tới
            </h5>
        </div>
        <div class="section-body">
            @if (futureTickets != null && futureTickets.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table custom-table align-middle">
                        <thead>
                            <tr>
                                <th>Mã vé</th>
                                <th>Chuyến bay</th>
                                <th>Khởi hành</th>
                                <th>Ghế</th>
                                <th>Hạng ghế</th>
                                <th>Hành lý</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ticket in futureTickets)
                            {
                                <tr>
                                    <td>
                                        <span class="ticket-id">@ticket.TicketId</span>
                                    </td>
                                    <td>
                                        <span class="flight-badge">
                                            <i class="bi bi-airplane"></i> #@ticket.Flight.FlightId
                                        </span>
                                    </td>
                                    <td>
                                        <div class="datetime-info">
                                            <i class="bi bi-calendar3"></i>
                                            @ticket.Flight.DepartureDateTime.ToString("dd/MM/yyyy HH:mm")
                                        </div>
                                    </td>
                                    <td>
                                        <div class="seat-info">
                                            <i class="bi bi-person-seat"></i> @ticket.Seat?.SeatNumber
                                        </div>
                                    </td>
                                    <td>
                                        <span class="seat-class-badge">
                                            @ticket.Seat?.SeatClass
                                        </span>
                                    </td>
                                    <td>
                                        <div class="baggage-container">
                                            @if (ticket.Baggages != null && ticket.Baggages.Any())
                                            {
                                                @foreach (var baggage in ticket.Baggages)
                                                {
                                                    <span class="baggage-badge">
                                                        <i class="bi bi-bag"></i> @baggage.Weight kg
                                                    </span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="no-baggage-badge">
                                                    <i class="bi bi-bag"></i> Không có
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td>
                                        <div class="action-buttons">
                                            <a asp-action="UpgradeSeat"
                                               asp-route-ticketId="@ticket.TicketId"
                                               class="action-btn btn-upgrade"
                                               title="Nâng hạng ghế">
                                                <i class="bi bi-arrow-up-circle"></i> Nâng hạng
                                            </a>
                                            <a asp-action="BuyExtraBaggage"
                                               asp-route-ticketId="@ticket.TicketId"
                                               class="action-btn btn-baggage"
                                               title="Mua thêm hành lý">
                                                <i class="bi bi-bag-plus"></i> Mua hành lý
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-calendar-x"></i>
                    <p>Bạn chưa có vé sắp tới.</p>
                </div>
            }
        </div>
    </div>

    <!-- Vé đã bay -->
    <div class="section-card past-tickets">
        <div class="section-header">
            <h5>
                <i class="bi bi-calendar-check"></i> Vé đã bay
            </h5>
        </div>
        <div class="section-body">
            @if (pastTickets != null && pastTickets.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table custom-table align-middle">
                        <thead>
                            <tr>
                                <th>Mã vé</th>
                                <th>Chuyến bay</th>
                                <th>Khởi hành</th>
                                <th>Ghế</th>
                                <th>Hạng ghế</th>
                                <th>Hành lý</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ticket in pastTickets)
                            {
                                <tr>
                                    <td>
                                        <span class="ticket-id">@ticket.TicketId</span>
                                    </td>
                                    <td>
                                        <span class="flight-badge">
                                            <i class="bi bi-airplane"></i> #@ticket.Flight.FlightId
                                        </span>
                                    </td>
                                    <td>
                                        <div class="datetime-info">
                                            <i class="bi bi-calendar3"></i>
                                            @ticket.Flight.DepartureDateTime.ToString("dd/MM/yyyy HH:mm")
                                        </div>
                                    </td>
                                    <td>
                                        <div class="seat-info">
                                            <i class="bi bi-person-seat"></i> @ticket.Seat?.SeatNumber
                                        </div>
                                    </td>
                                    <td>
                                        <span class="seat-class-badge">
                                            @ticket.Seat?.SeatClass
                                        </span>
                                    </td>
                                    <td>
                                        <div class="baggage-container">
                                            @if (ticket.Baggages != null && ticket.Baggages.Any())
                                            {
                                                @foreach (var baggage in ticket.Baggages)
                                                {
                                                    <span class="baggage-badge">
                                                        <i class="bi bi-bag"></i> @baggage.Weight kg
                                                    </span>
                                                }
                                            }
                                            else
                                            {
                                                <span class="no-baggage-badge">
                                                    <i class="bi bi-bag"></i> Không có
                                                </span>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-calendar-x"></i>
                    <p>Bạn chưa có vé đã bay.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Bootstrap Icons CDN (nếu chưa có) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">