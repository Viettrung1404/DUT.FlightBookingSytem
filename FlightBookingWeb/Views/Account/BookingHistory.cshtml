@{
    ViewData["Title"] = "Lịch sử đặt vé";
    var pastTickets = ViewBag.PastTickets as List<FlightBookingWeb.Models.Ticket>;
    var futureTickets = ViewBag.FutureTickets as List<FlightBookingWeb.Models.Ticket>;
}

@if (TempData["BaggageError"] != null)
{
    <div class="alert alert-danger text-center">
        @TempData["BaggageError"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger text-center">
        @TempData["ErrorMessage"]
    </div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success text-center">
        @TempData["SuccessMessage"]
    </div>
}

<div class="container py-4">
    <h2 class="mb-4 text-primary">
        <i class="bi bi-clock-history"></i> Lịch sử đặt vé
    </h2>

    <!-- Vé sắp tới -->
    <div class="card mb-5 shadow-sm">
        <div class="card-header bg-success text-white">
            <h5 class="mb-0">
                <i class="bi bi-calendar-event"></i> Vé sắp tới
            </h5>
        </div>
        <div class="card-body p-0">
            @if (futureTickets != null && futureTickets.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Mã vé</th>
                                <th>Chuyến bay</th>
                                <th>Khởi hành</th>
                                <th>Ghế</th>
                                <th>Hạng ghế</th>
                                <th>Hành lý</th>
                                <th>Trạng thái</th>
                                <th class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ticket in futureTickets)
                            {
                                <tr>
                                    <td>@ticket.TicketId</td>
                                    <td>
                                        <span class="badge bg-info text-dark">
                                            <i class="bi bi-airplane"></i> #@ticket.Flight.FlightId
                                        </span>
                                    </td>
                                    <td>
                                        <i class="bi bi-calendar3"></i>
                                        @ticket.Flight.DepartureDateTime.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td>
                                        <span class="fw-bold">
                                            <i class="bi bi-person-seat"></i> @ticket.Seat?.SeatNumber
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">
                                            @ticket.Seat?.SeatClass
                                        </span>
                                    </td>
                                    <td>
                                        @if (ticket.Baggages != null && ticket.Baggages.Any())
                                        {
                                            @foreach (var baggage in ticket.Baggages)
                                            {
                                                <span class="badge bg-success me-1">
                                                    <i class="bi bi-bag"></i> @baggage.Weight kg
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted">
                                                <i class="bi bi-bag"></i> Không có
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (ticket.Status == "Cancelled")
                                        {
                                            <span class="badge bg-danger">Đã hủy</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Đang hiệu lực</span>
                                        }
                                    </td>
                                    <td class="d-flex gap-2 justify-content-center">
                                        @if (ticket.Status != "Cancelled")
                                        {
                                            <a asp-action="UpgradeSeat"
                                               asp-route-ticketId="@ticket.TicketId"
                                               class="btn btn-warning btn-sm"
                                               title="Nâng hạng ghế">
                                                <i class="bi bi-arrow-up-circle"></i> Nâng hạng
                                            </a>
                                            <a asp-action="BuyExtraBaggage"
                                               asp-route-ticketId="@ticket.TicketId"
                                               class="btn btn-info btn-sm"
                                               title="Mua thêm hành lý">
                                                <i class="bi bi-bag-plus"></i> Mua hành lý
                                            </a>
                                            <a asp-action="CancelTicket"
                                               asp-route-ticketId="@ticket.TicketId"
                                               class="btn btn-danger btn-sm"
                                               title="Hủy vé"
                                               onclick="return confirm('Bạn có chắc chắn muốn hủy vé này? Lưu ý: Vé đã hủy sẽ không được hoàn tiền.')">
                                                <i class="bi bi-x-circle"></i> Hủy vé
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Không có thao tác</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-3 text-center text-muted">
                    Bạn chưa có vé sắp tới.
                </div>
            }
        </div>
    </div>

    <!-- Vé đã bay -->
    <div class="card shadow-sm">
        <div class="card-header bg-secondary text-white">
            <h5 class="mb-0">
                <i class="bi bi-calendar-check"></i> Vé đã bay
            </h5>
        </div>
        <div class="card-body p-0">
            @if (pastTickets != null && pastTickets.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-striped mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Mã vé</th>
                                <th>Chuyến bay</th>
                                <th>Khởi hành</th>
                                <th>Ghế</th>
                                <th>Hạng ghế</th>
                                <th>Hành lý</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ticket in pastTickets)
                            {
                                <tr>
                                    <td>@ticket.TicketId</td>
                                    <td>
                                        <span class="badge bg-info text-dark">
                                            <i class="bi bi-airplane"></i> #@ticket.Flight.FlightId
                                        </span>
                                    </td>
                                    <td>
                                        <i class="bi bi-calendar3"></i>
                                        @ticket.Flight.DepartureDateTime.ToString("dd/MM/yyyy HH:mm")
                                    </td>
                                    <td>
                                        <span class="fw-bold">
                                            <i class="bi bi-person-seat"></i> @ticket.Seat?.SeatNumber
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">
                                            @ticket.Seat?.SeatClass
                                        </span>
                                    </td>
                                    <td>
                                        @if (ticket.Baggages != null && ticket.Baggages.Any())
                                        {
                                            @foreach (var baggage in ticket.Baggages)
                                            {
                                                <span class="badge bg-success me-1">
                                                    <i class="bi bi-bag"></i> @baggage.Weight kg
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted">
                                                <i class="bi bi-bag"></i> Không có
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (ticket.Status == "Cancelled")
                                        {
                                            <span class="badge bg-danger">Đã hủy</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Đã hoàn thành</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="p-3 text-center text-muted">
                    Bạn chưa có vé đã bay.
                </div>
            }
        </div>
    </div>
</div>

<!-- Bootstrap Icons CDN -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<style>
    .table th, .table td {
        vertical-align: middle;
    }
    .badge {
        font-size: 0.9em;
        padding: 0.35em 0.65em;
    }
    .btn-sm {
        padding: 0.25rem 0.5rem;
        font-size: 0.875rem;
    }
</style>