@{
    var currentSeat = ViewBag.CurrentSeat as FlightBookingWeb.Models.Seat;
    var targetSeat = ViewBag.TargetSeat as FlightBookingWeb.Models.Seat;
    var ticketId = (int)ViewBag.TicketId;
    var targetSeatClass = targetSeat?.SeatClass ?? "";
    var extraAmount = (decimal)ViewBag.ExtraAmount;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow border-primary mb-4">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-arrow-up-circle me-2"></i>Confirm Seat Upgrade</h4>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="border rounded p-3 h-100">
                                <h5 class="text-secondary mb-2"><i class="bi bi-person-bounding-box"></i> Current Seat</h5>
                                <ul class="list-group list-group-flush">
                                    <li class="list-group-item">
                                        <b>Number:</b> <span class="badge bg-primary">@currentSeat?.SeatNumber</span>
                                    </li>
                                    <li class="list-group-item">
                                        <b>Class:</b> <span class="badge bg-warning text-dark">@currentSeat?.SeatClass</span>
                                    </li>
                                    <li class="list-group-item">
                                        <b>Type:</b> <span class="badge bg-secondary">@currentSeat?.SeatType</span>
                                    </li>
                                    <li class="list-group-item">
                                        <b>Price:</b> <span class="text-info">@ViewBag.CurrentSeatPrice.ToString("C")</span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="border rounded p-3 h-100 bg-light">
                                <h5 class="text-success mb-2"><i class="bi bi-person-fill-up"></i> New Seat</h5>
                                <ul class="list-group list-group-flush">
                                    <li class="list-group-item">
                                        <b>Number:</b> <span class="badge bg-success">@targetSeat?.SeatNumber</span>
                                    </li>
                                    <li class="list-group-item">
                                        <b>Class:</b> <span class="badge bg-warning text-dark">@targetSeat?.SeatClass</span>
                                    </li>
                                    <li class="list-group-item">
                                        <b>Type:</b> <span class="badge bg-secondary">@targetSeat?.SeatType</span>
                                    </li>
                                    <li class="list-group-item">
                                        <b>Price:</b> <span class="text-success">@ViewBag.TargetSeatPrice.ToString("C")</span>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <div class="alert alert-info mt-4 fs-5 text-center">
                        <b>Extra Amount to Pay:</b>
                        <span class="text-success fw-bold">@extraAmount.ToString("C")</span>
                    </div>
                    <div id="paypal-upgrade-container" class="my-3 text-center"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap Icons CDN (nếu chưa có) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

@section Scripts {
    <!-- PayPal SDK -->
    <script src="https://www.paypal.com/sdk/js?client-id=Af-WtkZ5kCVKHEhpFkoFhky-76AatSg3PghCyxCaFlJR9Ix9j2ZAHf1iWBhPTCbkKIYa7ShuT6Rkc8OM&currency=USD"></script>
    <script src="~/js/update_seat.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            renderUpgradePayPalButton(
        @ticketId,
                '@targetSeatClass',
                '#paypal-upgrade-container'
            );
        });
    </script>
}
