@{
    var currentSeat = ViewBag.CurrentSeat as FlightBookingWeb.Models.Seat;
    var targetSeat = ViewBag.TargetSeat as FlightBookingWeb.Models.Seat;
    var ticketId = (int)ViewBag.TicketId;
    var targetSeatClass = targetSeat?.SeatClass ?? "";
    var extraAmount = (decimal)ViewBag.ExtraAmount;
}

<style>
    body {
        min-height: 100vh;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .upgrade-container {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        border-radius: 20px;
        border: 1px solid rgba(255, 255, 255, 0.2);
        box-shadow: 0 8px 32px rgba(31, 38, 135, 0.37);
        padding: 2rem;
        margin: 2rem 0;
    }

    .upgrade-card {
        background: rgba(255, 255, 255, 0.95);
        border-radius: 20px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        border: none;
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .upgrade-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.15);
        }

    .card-header-custom {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        padding: 1.5rem;
        border: none;
        position: relative;
        overflow: hidden;
    }

        .card-header-custom::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
            transition: left 0.5s;
        }

        .card-header-custom:hover::before {
            left: 100%;
        }

    .seat-comparison {
        padding: 2rem;
        background: linear-gradient(145deg, #f8f9ff 0%, #e8f2ff 100%);
    }

    .seat-card {
        border-radius: 15px;
        padding: 1.5rem;
        height: 100%;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

    .current-seat {
        background: linear-gradient(145deg, #fff 0%, #f0f4f8 100%);
        border: 2px solid #e2e8f0;
    }

    .new-seat {
        background: linear-gradient(145deg, #f0fff4 0%, #e6fffa 100%);
        border: 2px solid #38a169;
        position: relative;
    }

        .new-seat::before {
            content: '✨';
            position: absolute;
            top: 10px;
            right: 15px;
            font-size: 1.5rem;
            animation: sparkle 2s infinite;
        }

    @@keyframes sparkle {
        0%, 100%

    {
        opacity: 1;
        transform: scale(1);
    }

    50% {
        opacity: 0.7;
        transform: scale(1.2);
    }

    }

    .seat-header {
        display: flex;
        align-items: center;
        margin-bottom: 1rem;
        font-weight: 600;
    }

        .seat-header i {
            margin-right: 0.5rem;
            font-size: 1.2rem;
        }

    .seat-details {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .seat-detail-item {
        padding: 0.75rem 0;
        border-bottom: 1px solid rgba(0,0,0,0.1);
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: background-color 0.2s ease;
    }

        .seat-detail-item:hover {
            background-color: rgba(0,0,0,0.02);
            border-radius: 8px;
            margin: 0 -0.5rem;
            padding: 0.75rem 1rem;
        }

        .seat-detail-item:last-child {
            border-bottom: none;
        }

    .badge-custom {
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-weight: 500;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .badge-seat-number {
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: white;
        box-shadow: 0 2px 10px rgba(102, 126, 234, 0.3);
    }

    .badge-seat-class {
        background: linear-gradient(135deg, #f093fb, #f5576c);
        color: white;
        box-shadow: 0 2px 10px rgba(240, 147, 251, 0.3);
    }

    .badge-seat-type {
        background: linear-gradient(135deg, #4facfe, #00f2fe);
        color: white;
        box-shadow: 0 2px 10px rgba(79, 172, 254, 0.3);
    }

    .price-display {
        font-weight: 700;
        font-size: 1.1rem;
    }

    .current-price {
        color: #4a5568;
    }

    .new-price {
        color: #38a169;
    }

    .extra-amount-card {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border-radius: 15px;
        padding: 2rem;
        text-align: center;
        margin: 2rem 0;
        position: relative;
        overflow: hidden;
    }

        .extra-amount-card::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: repeating-linear-gradient( 45deg, transparent, transparent 10px, rgba(255,255,255,0.05) 10px, rgba(255,255,255,0.05) 20px );
            animation: move 10s linear infinite;
        }

    @@keyframes move {
        0%

    {
        transform: translate(-50%, -50%) rotate(0deg);
    }

    100% {
        transform: translate(-50%, -50%) rotate(360deg);
    }

    }

    .extra-amount-content {
        position: relative;
        z-index: 1;
    }

    .extra-amount-label {
        font-size: 1.1rem;
        margin-bottom: 0.5rem;
        opacity: 0.9;
    }

    .extra-amount-value {
        font-size: 2.5rem;
        font-weight: 700;
        text-shadow: 0 2px 4px rgba(0,0,0,0.2);
    }

    .paypal-container {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(5px);
        border-radius: 15px;
        padding: 1.5rem;
        margin: 1.5rem 0;
        border: 1px solid rgba(255, 255, 255, 0.2);
    }

    .upgrade-arrow {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        z-index: 10;
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: white;
        width: 60px;
        height: 60px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0%

    {
        transform: translate(-50%, -50%) scale(1);
    }

    50% {
        transform: translate(-50%, -50%) scale(1.1);
    }

    100% {
        transform: translate(-50%, -50%) scale(1);
    }

    }

    @@media (max-width: 768px) {
        .upgrade-arrow

    {
        position: static;
        transform: rotate(90deg);
        margin: 1rem auto;
    }

    .upgrade-container {
        margin: 1rem;
        padding: 1rem;
    }

    }

    /* Animation for page load */
    .seat-card {
        animation: slideInUp 0.6s ease-out;
    }

    .current-seat {
        animation-delay: 0.1s;
    }

    .new-seat {
        animation-delay: 0.3s;
    }

    @@keyframes slideInUp {
        from

    {
        opacity: 0;
        transform: translateY(30px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

    }
</style>

<div class="container-fluid">
    <div class="upgrade-container">
        <div class="row justify-content-center">
            <div class="col-xl-10 col-lg-11">
                <div class="upgrade-card">
                    <div class="card-header-custom">
                        <h4 class="mb-0 text-center">
                            <i class="bi bi-arrow-up-circle me-2"></i>
                            Confirm Seat Upgrade
                        </h4>
                    </div>

                    <div class="seat-comparison">
                        <div class="row g-4 position-relative">
                            <!-- Current Seat -->
                            <div class="col-lg-6">
                                <div class="seat-card current-seat">
                                    <div class="seat-header text-secondary">
                                        <i class="bi bi-person-bounding-box"></i>
                                        Current Seat
                                    </div>
                                    <ul class="seat-details">
                                        <li class="seat-detail-item">
                                            <span><strong>Number:</strong></span>
                                            <span class="badge-custom badge-seat-number">@currentSeat?.SeatNumber</span>
                                        </li>
                                        <li class="seat-detail-item">
                                            <span><strong>Class:</strong></span>
                                            <span class="badge-custom badge-seat-class">@currentSeat?.SeatClass</span>
                                        </li>
                                        <li class="seat-detail-item">
                                            <span><strong>Type:</strong></span>
                                            <span class="badge-custom badge-seat-type">@currentSeat?.SeatType</span>
                                        </li>
                                        <li class="seat-detail-item">
                                            <span><strong>Price:</strong></span>
                                            <span class="price-display current-price">@ViewBag.CurrentSeatPrice.ToString("C")</span>
                                        </li>
                                    </ul>
                                </div>
                            </div>

                            <!-- Upgrade Arrow -->
                            <div class="upgrade-arrow d-none d-lg-flex">
                                <i class="bi bi-arrow-right"></i>
                            </div>
                            <div class="upgrade-arrow d-lg-none">
                                <i class="bi bi-arrow-down"></i>
                            </div>

                            <!-- New Seat -->
                            <div class="col-lg-6">
                                <div class="seat-card new-seat">
                                    <div class="seat-header text-success">
                                        <i class="bi bi-person-fill-up"></i>
                                        New Seat
                                    </div>
                                    <ul class="seat-details">
                                        <li class="seat-detail-item">
                                            <span><strong>Number:</strong></span>
                                            <span class="badge-custom badge-seat-number">@targetSeat?.SeatNumber</span>
                                        </li>
                                        <li class="seat-detail-item">
                                            <span><strong>Class:</strong></span>
                                            <span class="badge-custom badge-seat-class">@targetSeat?.SeatClass</span>
                                        </li>
                                        <li class="seat-detail-item">
                                            <span><strong>Type:</strong></span>
                                            <span class="badge-custom badge-seat-type">@targetSeat?.SeatType</span>
                                        </li>
                                        <li class="seat-detail-item">
                                            <span><strong>Price:</strong></span>
                                            <span class="price-display new-price">@ViewBag.TargetSeatPrice.ToString("C")</span>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        <!-- Extra Amount -->
                        <div class="extra-amount-card">
                            <div class="extra-amount-content">
                                <div class="extra-amount-label">Extra Amount to Pay</div>
                                <div class="extra-amount-value">@extraAmount.ToString("C")</div>
                            </div>
                        </div>

                        <!-- PayPal Container -->
                        <div class="paypal-container">
                            <div id="paypal-upgrade-container" class="text-center"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap Icons CDN -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">

@section Scripts {
    <!-- PayPal SDK -->
    <script src="https://www.paypal.com/sdk/js?client-id=Af-WtkZ5kCVKHEhpFkoFhky-76AatSg3PghCyxCaFlJR9Ix9j2ZAHf1iWBhPTCbkKIYa7ShuT6Rkc8OM&currency=USD"></script>
    <script src="~/js/update_seat.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            renderUpgradePayPalButton(
        @ticketId,
                '@targetSeatClass',
                '#paypal-upgrade-container'
            );
        });
    </script>
}