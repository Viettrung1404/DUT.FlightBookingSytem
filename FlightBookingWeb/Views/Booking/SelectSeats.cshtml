@model FlightBookingWeb.ViewModels.SeatSelectionViewModel

@section CSS {
    <style>
        /* Custom Radio Button Styling */
        input.custom-radio {
            appearance: none; /* Remove default browser styling */
            -webkit-appearance: none;
            -moz-appearance: none;
            width: 18px;
            height: 18px;
            border: 2px solid #007bff; /* Blue border */
            border-radius: 50%; /* Circular shape */
            background-color: #fff;
            cursor: pointer;
            position: relative;
            transition: all 0.2s ease;
            display: inline-block;
            vertical-align: middle;
        }

            input.custom-radio:checked {
                background-color: #007bff; /* Blue fill when checked */
                border-color: #0056b3; /* Darker blue border */
            }

                input.custom-radio:checked::after {
                    content: '';
                    position: absolute;
                    top: 50%;
                    left: 50%;
                    width: 8px;
                    height: 8px;
                    background-color: #fff; /* White dot in center */
                    border-radius: 50%;
                    transform: translate(-50%, -50%);
                }

            input.custom-radio:hover {
                border-color: #0056b3; /* Darker blue on hover */
                box-shadow: 0 0 5px rgba(0, 123, 255, 0.3);
            }

            input.custom-radio:focus {
                outline: none;
                box-shadow: 0 0 0 3px rgba(0, 123, 255, 0.2); /* Blue focus ring */
            }
    </style>
}

<div class="container mt-5">
    <h2 class="text-center">Select Your Seats</h2>

    <form asp-action="ConfirmSeat" method="post" class="mt-4">
        <!-- Outbound Flight Seats -->
        @Html.ValidationSummary(false, "", new { @class = "text-danger" })
        <div class="row mt-4">
            <div class="col-md-12">
                <h4>Outbound Flight Seats</h4>
                <p>Flight ID: @Model.OutboundFlightId</p>
                <div class="row">
                    @foreach (var seat in Model.AvailableOutboundSeats)
                    {
                        <div class="col-md-2 mb-3">
                            <div class="form-check">
                                <input class="form-check-input custom-radio" type="checkbox"
                                       id="outboundSeat_@seat.SeatId"
                                       name="SelectedSeatsOutBoard"
                                       value="@seat.SeatNumber"
                                @(seat.IsBooked ?? false ? "disabled" : "")>
                                <label class="form-check-label @(seat.IsBooked ?? false ? "text-muted" : "")"
                                       for="outboundSeat_@seat.SeatId">
                                    @seat.SeatNumber (@seat.SeatClass)
                                    @if (seat.IsBooked ?? false)
                                    {
                                        <span class="badge bg-danger">Booked</span>
                                    }
                                </label>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Return Flight Seats (if applicable) -->
        @if (Model.IsRoundTrip && Model.AvailableReturnSeats != null)
        {
            <div class="row mt-4">
                <div class="col-md-12">
                    <h4>Return Flight Seats</h4>
                    <p>Flight ID: @Model.ReturnFlightId</p>
                    <div class="row">
                        @foreach (var seat in Model.AvailableReturnSeats)
                        {
                            <div class="col-md-2 mb-3">
                                <div class="form-check">
                                    <input class="form-check-input custom-radio" type="checkbox"
                                           id="returnSeat_@seat.SeatId"
                                           name="SelectedSeatsReturnBoard"
                                           value="@seat.SeatNumber"
                                    @(seat.IsBooked ?? false ? "disabled" : "")>
                                    <label class="form-check-label @(seat.IsBooked ?? false ? "text-muted" : "")"
                                           for="returnSeat_@seat.SeatId">
                                        @seat.SeatNumber (@seat.SeatClass)
                                        @if (seat.IsBooked ?? false)
                                        {
                                            <span class="badge bg-danger">Booked</span>
                                        }
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        <!-- Hidden fields -->
        <input type="hidden" name="PassengerCount" value="@Model.PassengerCount" />
        <input type="hidden" name="OutboundFlightId" value="@Model.OutboundFlightId" />
        <input type="hidden" name="ReturnFlightId" value="@Model.ReturnFlightId" />
        <input type="hidden" name="IsRoundTrip" value="@Model.IsRoundTrip.ToString()" />

        <!-- Submit Button -->
        <div class="row mt-4">
            <div class="col-md-12 text-center">
                <button type="submit" class="btn btn-primary btn-lg"> Countinue </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}