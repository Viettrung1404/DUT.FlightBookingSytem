@model FlightBookingWeb.ViewModels.FlightSearchResultsViewModel

@{
	ViewData["Title"] = "Flight Listing";
	ViewData["ActivePage"] = "FlightListing";
	var arrivalTime = Model.OutboundFlights.FirstOrDefault()?.DepartureOutBoardDate;
}

@section CSS {
    <!-- Optional Custom CSS for Consistency -->
    <style>
        .booking-form {
            max-width: 1200px;
            margin: 0 auto;
        }

        .section-header {
            border-bottom: 2px solid #f0f0f0;
            padding-bottom: 10px;
        }

        .flight-card {
            border-radius: 10px;
            transition: all 0.3s ease;
            border: 2px solid transparent;
        }

            .flight-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
            }

        .form-check-input:checked ~ .flight-card {
            border-color: #0d6efd;
        }

        .form-check-input {
            width: 1.5em;
            height: 1.5em;
            cursor: pointer;
        }

        .airport-code {
            font-size: 1.1rem;
        }

        .flight-time {
            color: #343a40;
        }

        /* Active state for selected flight */
        input[type="radio"]:checked + label + .flight-card,
        .flight-card:has(input[type="radio"]:checked) {
            border-color: #0d6efd;
            background-color: blanchedalmond;
        }

        .card .card-body {
            flex: 1 1 auto;
            padding: var(--bs-card-spacer-y) var(--bs-card-spacer-x);
            color: var(--bs-card-color);
        }

        /* Custom Radio Button Styling */
        input.custom-radio {
            appearance: none; /* Remove default browser styling */
            -webkit-appearance: none;
            -moz-appearance: none;
            width: 18px;
            height: 18px;
            border: 2px solid #007bff; /* Blue border */
            border-radius: 50%; /* Circular shape */
            background-color: #fff;
            cursor: pointer;
            position: relative;
            transition: all 0.2s ease;
            display: inline-block;
            vertical-align: middle;
        }

            input.custom-radio:checked {
                background-color: #007bff; /* Blue fill when checked */
                border-color: #0056b3; /* Darker blue border */
            }

                input.custom-radio:checked::after {
                    content: '';
                    position: absolute;
                    top: 50%;
                    left: 50%;
                    width: 8px;
                    height: 8px;
                    background-color: #fff; /* White dot in center */
                    border-radius: 50%;
                    transform: translate(-50%, -50%);
                }

            input.custom-radio:hover {
                border-color: #0056b3; /* Darker blue on hover */
                box-shadow: 0 0 5px rgba(0, 123, 255, 0.3);
            }

            input.custom-radio:focus {
                outline: none;
                box-shadow: 0 0 0 3px rgba(0, 123, 255, 0.2); /* Blue focus ring */
            }
    </style>
}

<!-- Title-Banner Start -->
<div class="title-banner">
    <div class="container-fluid">
        <div class="row">
            <div class="banner-area v-2--">
                <img src="~/assets/media/banner/vacation.png" alt="" class="left-image">
                <div class="content-box text-alignment">
                    <h1 class="fw-700 lightest-black">Danh sách chuyến bay</h1>
                </div>
                <img src="~/assets/media/banner/plane-2.png" alt="" class="right-image">
            </div>
        </div>
    </div>
</div>
<!-- Title-Banner End -->

<div class="page-content m-0">
    <form asp-action="SelectSeats" asp-controller="Booking" method="get" class="booking-form container my-5">
    <input type="hidden" name="passengerCount" value="@Model.PassengerCount" />
    
    <!-- Outbound Flights -->
    <div class="flight-section mb-5">
        <div class="section-header d-flex align-items-center mb-3">
            <div class="section-icon me-3">
                <i class="fas fa-plane-departure text-primary fs-3"></i>
            </div>
            <h3 class="section-title m-0">Chuyến bay đi</h3>
        </div>
        
        @if (Model.OutboundFlights != null && Model.OutboundFlights.Any())
        {
            <div class="flight-list">
                @foreach (var flight in Model.OutboundFlights)
                {
                    <div class="flight-card card mb-3 shadow-sm">
                        <div class="card-body">
                            <div class="row align-items-center">
                                <div class="col-md-1 text-center">
                                    <div class="form-check">
                                        <input class="form-check-input custom-radio" type="radio" name="outboundFlightId" value="@flight.FlightId" id="outbound-@flight.FlightId" required>
                                        <label class="form-check-label" for="outbound-@flight.FlightId"></label>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <span class="badge bg-primary mb-2">ID: @flight.FlightId</span>
                                    <div class="flight-time fw-bold fs-5">@flight.DepartureOutBoardDate.ToString("HH:mm")</div>
                                    <div class="flight-date text-muted">@flight.DepartureOutBoardDate.ToString("dd/MM/yyyy")</div>
                                </div>
                                <div class="col-md-3">
                                    <div class="airport-code fw-bold">@flight.DepartureAirport</div>
                                    <div class="airport-name text-muted">Sân bay đi</div>
                                </div>
                                <div class="col-md-1 text-center">
                                    <i class="fas fa-arrow-right text-muted"></i>
                                </div>
                                <div class="col-md-3">
                                    <div class="airport-code fw-bold">@flight.ArrivalAirport</div>
                                    <div class="airport-name text-muted">Sân bay đến</div>
                                </div>
                                <div class="col-md-2 text-end">
                                    <div class="flight-price fw-bold fs-4 text-primary">
                                        @(flight.Price.HasValue ? flight.Price.Value.ToString("N0") : "N/A") ₫
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-2"></i> Không tìm thấy chuyến bay đi.
            </div>
        }
    </div>

    <!-- Return Flights -->
    @if (Model.IsRoundTrip)
    {
        <div class="flight-section mb-5">
            <div class="section-header d-flex align-items-center mb-3">
                <div class="section-icon me-3">
                    <i class="fas fa-plane-arrival text-success fs-3"></i>
                </div>
                <h3 class="section-title m-0">Chuyến bay về</h3>
            </div>
            
            @if (Model.ReturnFlights != null && Model.ReturnFlights.Any())
            {
                <div class="flight-list">
                    @foreach (var flight in Model.ReturnFlights)
                    {
                        <div class="flight-card card mb-3 shadow-sm">
                            <div class="card-body">
                                <div class="row align-items-center">
                                    <div class="col-md-1 text-center">
                                        <div class="form-check">
                                                <input class="form-check-input custom-radio" type="radio" name="returnFlightId" value="@flight.FlightId" id="return-@flight.FlightId" required>
                                            <label class="form-check-label" for="return-@flight.FlightId"></label>
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <span class="badge bg-success mb-2">ID: @flight.FlightId</span>
                                        <div class="flight-time fw-bold fs-5">@flight.DepartureOutBoardDate.ToString("HH:mm")</div>
                                        <div class="flight-date text-muted">@flight.DepartureOutBoardDate.ToString("dd/MM/yyyy")</div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="airport-code fw-bold">@flight.DepartureAirport</div>
                                        <div class="airport-name text-muted">Sân bay đi</div>
                                    </div>
                                    <div class="col-md-1 text-center">
                                        <i class="fas fa-arrow-right text-muted"></i>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="airport-code fw-bold">@flight.ArrivalAirport</div>
                                        <div class="airport-name text-muted">Sân bay đến</div>
                                    </div>
                                    <div class="col-md-2 text-end">
                                        <div class="flight-price fw-bold fs-4 text-success">
                                            @(flight.Price.HasValue ? flight.Price.Value.ToString("N0") : "N/A") ₫
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i> Không tìm thấy chuyến bay về.
                </div>
            }
        </div>
    }

    <div class="action-section text-center mt-5">
        <button type="submit" class="btn btn-primary btn-lg px-5 py-3 rounded-pill shadow">
            <i class="fas fa-chair me-2"></i> Tiếp tục chọn ghế
        </button>
    </div>
    </form>
</div>


</div>